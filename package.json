{
  "name": "sqa",
  "version": "0.1.0",
  "description": "Checks that a web app behaves as described in capabilities.md, using Playwright and Jev.",
  "type": "module",
  "bin": {
    "sqa": "bin/sqa.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
